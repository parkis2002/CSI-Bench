{
  "pipeline": "supervised",

  "training_dir": "./csi-bench-dataset",
  "output_dir": "./results",

  "task": "HumanActivityRecognition",
  "available_models": ["hiercsiformer"],

  "win_len": 500,
  "feature_size": 232,

  "batch_size": 128,
  "epochs": 100,
  "learning_rate": 0.001,
  "weight_decay": 1e-5,
  "warmup_epochs": 2,
  "patience": 5,
  "seed": 42,

  "test_splits": "test_id",

  "model_params": {
    "use_augmentation": true,
    "use_domain_adversarial": true,
    "domain_lambda": 0.01,
    "da_start_threshold": 0.60,
    "coral_lambda": 1.0,
    "partial_adv_frac": 0.5,
    "freeze_frac": 0.2,
    "noise_prob": 0.2,
    "shift_prob": 0.2,
    "amplitude_prob": 0.3,
    "mixup_prob": 0.1,
    "max_shift": 10,
    "label_smoothing": 0.1,
    "hiercsi_d_model": 256,
    "hiercsi_layers": 6
  }
}
