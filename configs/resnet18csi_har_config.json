{
  "pipeline": "supervised",

  "training_dir": "./csi-bench-dataset",
  "output_dir": "./results",

  "task": "HumanActivityRecognition",
  "available_models": ["resnet18csi"],

  "win_len": 500,
  "feature_size": 232,

  "batch_size": 256,
  "epochs": 200,
  "learning_rate": 0.0002,
  "weight_decay": 1e-5,
  "warmup_epochs": 5,
  "patience": 15,
  "seed": 42,

  "test_splits": "all",

  "model_params": {
    "use_augmentation": true,
    "use_domain_adversarial": false,
    "focal_gamma": 2.0,
    "noise_prob": 0.2,
    "noise_scale": 0.01,
    "shift_prob": 0.2,
    "amplitude_prob": 0.3,
    "amplitude_lo": 0.9,
    "amplitude_hi": 1.1,
    "mixup_prob": 0.1,
    "max_shift": 10,
    "dropout": 0.2
  },

  "per_model_params": {
    "resnet18csi": {
      "learning_rate": 0.0002,
      "model_params": {
        "dropout": 0.2
      }
    }
  }
}
